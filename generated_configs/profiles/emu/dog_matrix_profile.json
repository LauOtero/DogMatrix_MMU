{
  "capabilities": {
    "cutter": false,
    "encoder": true,
    "endless_spool": true,
    "espooler": true,
    "gate_sensors": true,
    "led": true,
    "nfc": true,
    "selector": false,
    "servo": false,
    "spoolman": true,
    "sync_feedback": false,
    "toolhead_sensor": true
  },
  "display_name": "EMU Modular",
  "hardware": {
    "led": {
      "count": 8,
      "pin": "main:PA0",
      "type": "neopixel"
    },
    "mcu": [
      {
        "name": "mmu_main",
        "serial_by_id": "/dev/serial/by-id/usb-DogMatrix_MMU-main-if00",
        "transport": "usb"
      },
      {
        "name": "mmu_gates",
        "serial_by_id": "/dev/serial/by-id/usb-DogMatrix_MMU-gates-if00",
        "transport": "usb"
      }
    ],
    "nfc": {
      "address": "0x24",
      "bus": "i2c",
      "type": "pn532"
    }
  },
  "limits": {
    "bowden_length_mm": 550,
    "encoder_error_mm": 5,
    "max_accel_mm_s2": 1800,
    "max_distance_mm": 1300,
    "max_jerk_mm_s3": 9000,
    "max_load_speed_mm_s": 75,
    "max_unload_speed_mm_s": 90,
    "sensor_timeout_ms": 500,
    "toolhead_distance_mm": 75
  },
  "profile_id": "dog_matrix.emu.v1",
  "schema_version": 1,
  "topology": {
    "gates": 8,
    "selector_type": "virtual",
    "type": "modular",
    "units": 2
  }
}
